          <img
            src="https://images.unsplash.com/photo-1504917599217-d4dc5ebe6122?w=600&q=80"
            alt="Steel & Fabrication Industry"
            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0D1117] via-transparent to-transparent opacity-90"></div>
          <div class="absolute bottom-0 left-0 w-full p-6 border-b-4 border-transparent group-hover:border-primary-container transition-all">
            <h4 class="font-headline-sm text-headline-sm text-surface-white uppercase">Steel & Fabrication</h4>
          </div>
        </div>

        {/* Tile 2 */}
        <div class="relative h-72 group overflow-hidden bg-[#0D1117]" data-aos="fade-up" data-aos-delay="80">
          <img
            src="https://images.unsplash.com/photo-1516214104703-d870798883c5?w=600&q=80"
            alt="Shipbuilding & Port Industry"
            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0D1117] via-transparent to-transparent opacity-90"></div>
          <div class="absolute bottom-0 left-0 w-full p-6 border-b-4 border-transparent group-hover:border-primary-container transition-all">
            <h4 class="font-headline-sm text-headline-sm text-surface-white uppercase">Shipbuilding & Port</h4>
          </div>
        </div>

        {/* Tile 3 */}
        <div class="relative h-72 group overflow-hidden bg-[#0D1117]" data-aos="fade-up" data-aos-delay="160">
          <img
            src="https://images.unsplash.com/photo-1563986768609-322da13575f3?w=600&q=80"
            alt="Automotive Industry"
            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0D1117] via-transparent to-transparent opacity-90"></div>
          <div class="absolute bottom-0 left-0 w-full p-6 border-b-4 border-transparent group-hover:border-primary-container transition-all">
            <h4 class="font-headline-sm text-headline-sm text-surface-white uppercase">Automotive</h4>
          </div>
        </div>

        {/* Tile 4 */}
        <div class="relative h-72 group overflow-hidden bg-[#0D1117]" data-aos="fade-up" data-aos-delay="240">
          <img
            src="https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?w=600&q=80"
            alt="Construction Industry"
            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0D1117] via-transparent to-transparent opacity-90"></div>
          <div class="absolute bottom-0 left-0 w-full p-6 border-b-4 border-transparent group-hover:border-primary-container transition-all">
            <h4 class="font-headline-sm text-headline-sm text-surface-white uppercase">Construction</h4>
          </div>
        </div>

        {/* Tile 5 */}
        <div class="relative h-72 group overflow-hidden bg-[#0D1117]" data-aos="fade-up" data-aos-delay="320">
          <img
            src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=600&q=80"
            alt="Power & Energy Industry"
            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0D1117] via-transparent to-transparent opacity-90"></div>
          <div class="absolute bottom-0 left-0 w-full p-6 border-b-4 border-transparent group-hover:border-primary-container transition-all">
            <h4 class="font-headline-sm text-headline-sm text-surface-white uppercase">Power & Energy</h4>
          </div>
        </div>

        {/* Tile 6 */}
        <div class="relative h-72 group overflow-hidden bg-[#0D1117]" data-aos="fade-up" data-aos-delay="400">
          <img
            src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&q=80"
            alt="Warehousing Industry"
            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
