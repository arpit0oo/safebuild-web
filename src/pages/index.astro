          </p>
        </div>

        {/* Feature 3 */}
        <div class="bg-surface-white p-8 border border-border-subtle hover-border-accent card-shadow group" data-aos="fade-up" data-aos-delay="200">
          <span class="material-symbols-outlined text-primary-container text-4xl mb-6 block">architecture</span>
          <h4 class="font-headline-sm text-headline-sm text-on-surface mb-3 uppercase">Custom Solutions</h4>
          <p class="font-body-md text-body-md text-on-surface-variant">
