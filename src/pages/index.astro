      </div>
    </div>
  </section>


  {/* ================================================================
      SECTION 4: WHY SAFE BUILD (THE ADVANTAGE)
      ================================================================ */}
  <section class="bg-surface-container-low py-section-padding">
    <div class="max-w-container-max mx-auto px-gutter flex flex-col lg:flex-row gap-12 lg:gap-24 items-center">

