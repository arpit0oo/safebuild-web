---
// =============================================================
// src/pages/index.astro — Safe Build Engineering
// Homepage — Dynamic featured products via Firestore, GSAP hero,
// AOS animations on sections, clean component layout with BaseLayout.
// =============================================================

import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ProductCard from "../components/ProductCard.astro";
import { getFeaturedProducts, getProducts } from "../lib/sanity";
import type { Product } from "../lib/types";

// ── SSR: Fetch featured products ─────────────────────────────
let featuredProducts: Product[] = [];
try {
  featuredProducts = await getFeaturedProducts(6);
  if (featuredProducts.length === 0) {
    const all = await getProducts();
    featuredProducts = all.filter((p) => p.isFeatured).slice(0, 6);
  }
} catch (e) {
  console.warn(
    "[index.astro] getFeaturedProducts query failed, falling back to all products filter:",
    e,
  );
  try {
    const all = await getProducts();
    featuredProducts = all.filter((p) => p.isFeatured).slice(0, 6);
  } catch (err) {
    console.error("[index.astro] Firestore fetch error:", err);
  }
}
