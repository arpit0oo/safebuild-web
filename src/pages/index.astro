  {
    /* ================================================================
      GSAP HERO ANIMATION SCRIPT
      Staggered word reveal for Hero H1
      ================================================================ */
  }
  <script>
    import { gsap } from "gsap";

    function initHeroAnimation() {
      const heroWords = document.querySelectorAll(".hero-word");
      if (heroWords.length > 0) {
        gsap.fromTo(
          heroWords,
          { opacity: 0, y: 35 },
          {
            opacity: 1,
            y: 0,
            duration: 0.9,
            stagger: 0.15,
            ease: "power3.out",
          },
        );
      }
    }

    // Run on view transition page load and initial load
    document.addEventListener("astro:page-load", initHeroAnimation);
    initHeroAnimation();
  </script>
