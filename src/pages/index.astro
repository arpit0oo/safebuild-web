---
// =============================================================
// src/pages/index.astro — Safe Build Engineering
// Homepage — Dynamic featured products via Firestore, GSAP hero,
// AOS animations on sections, clean component layout with BaseLayout.
// =============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProductCard from '../components/ProductCard.astro';
import { getFeaturedProducts, getProducts } from '../lib/firestore';
import type { Product } from '../lib/types';

// ── SSR: Fetch featured products ─────────────────────────────
let featuredProducts: Product[] = [];
try {
  featuredProducts = await getFeaturedProducts(6);
  if (featuredProducts.length === 0) {
    const all = await getProducts();
    featuredProducts = all.filter(p => p.isFeatured).slice(0, 6);
  }
} catch (e) {
  console.warn('[index.astro] getFeaturedProducts query failed, falling back to all products filter:', e);
  try {
    const all = await getProducts();
    featuredProducts = all.filter(p => p.isFeatured).slice(0, 6);
  } catch (err) {
    console.error('[index.astro] Firestore fetch error:', err);
  }
}
---

<BaseLayout
  title="Safe Build Engineering — Industrial Cranes & Hoists"
  description="Safe Build Engineering designs and manufactures EOT cranes, gantry cranes, and hoists for Indian industry. Built to Lift. Built to Last."
  activePage="home"
>

  {/* ================================================================
      SECTION 1: HERO
      Dark theme, GSAP staggered word reveal on H1
      ================================================================ */}
  <section class="relative w-full h-screen flex items-center overflow-hidden bg-[#0D1117]">
    {/* Background Image with Dark Overlay */}
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-[#0D1117]/80 z-10"></div>
      <img
        src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=1600&q=80"
        alt="Heavy industrial crane manufacturing background"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    {/* Hero Content Container */}
    <div class="relative z-20 w-full max-w-container-max mx-auto px-gutter lg:px-section-padding border-l-4 border-primary-container h-full flex flex-col justify-center">
      <p class="font-label-caps text-label-caps text-primary-container mb-6 tracking-widest uppercase">
        — PRECISION CRANE MANUFACTURING
      </p>

      {/* GSAP Target H1 */}
      <h1 id="hero-title" class="font-display-xl text-display-xl text-surface-white mb-6 max-w-4xl uppercase leading-none">
        <span class="hero-word inline-block">India's</span>{' '}
        <span class="hero-word inline-block">Next-Generation</span><br />
        <span class="hero-word border-b-4 border-primary-container pb-2 inline-block mt-2">
          Crane Manufacturer.
        </span>
      </h1>

      <p class="font-body-lg text-body-lg text-secondary-fixed-dim mb-10 max-w-2xl">
        Engineering heavy-duty lifting solutions for the world's most demanding industrial environments.
        Precision-built, zero-margin error.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="/products"
          class="btn-primary"
          id="hero-explore-cta"
        >
          Explore Products
          <span class="material-symbols-outlined text-[18px] leading-none">arrow_forward</span>
        </a>
        <a
          href="/contact?type=quote"
          class="btn-ghost"
          id="hero-quote-cta"
        >
          Request a Quote
        </a>
      </div>
    </div>

    {/* Scroll indicator icon */}
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 z-20 animate-bounce">
      <span class="material-symbols-outlined text-surface-white/70 text-4xl">expand_more</span>
    </div>

    <div class="absolute bottom-8 right-8 z-20 hidden md:block">
      <p class="font-technical-data text-technical-data text-surface-white/50 tracking-widest uppercase text-right">
        EST. 2024 — LUCKNOW, INDIA
