  {/* ================================================================
      SECTION 7: CTA BANNER
      ================================================================ */}
  <section class="bg-primary-container relative overflow-hidden py-24">
    <div class="max-w-container-max mx-auto px-gutter relative z-10 flex flex-col md:flex-row items-center justify-between">
      <div class="w-full md:w-2/3 mb-10 md:mb-0" data-aos="fade-up">
        <h2 class="font-headline-lg text-headline-lg text-surface-white mb-4 uppercase">
          Ready to Lift Your Operations?
        </h2>
        <p class="font-body-lg text-body-lg text-surface-white/90 mb-8 max-w-xl">
          Speak with our engineering team to design a lifting solution tailored to your facility's exact specifications.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/contact?type=quote"
            class="btn-dark"
            id="cta-get-quote"
          >
            Get a Quote →
          </a>
          <a
            href="/products"
            class="btn-ghost"
            id="cta-explore-products"
          >
            Explore Products
          </a>
        </div>
      </div>

      <div class="w-full md:w-1/3 flex justify-end opacity-20 pointer-events-none" data-aos="fade-left">
        <span class="material-symbols-outlined text-[200px] text-surface-white leading-none">
          precision_manufacturing
        </span>
      </div>
    </div>
  </section>

  {/* ================================================================
      GSAP HERO ANIMATION SCRIPT
      Staggered word reveal for Hero H1
      ================================================================ */}
  <script>
    import { gsap } from 'gsap';

    function initHeroAnimation() {
      const heroWords = document.querySelectorAll('.hero-word');
      if (heroWords.length > 0) {
        gsap.fromTo(
          heroWords,
          { opacity: 0, y: 35 },
          {
            opacity: 1,
            y: 0,
            duration: 0.9,
            stagger: 0.15,
            ease: 'power3.out',
          }
        );
      }
    }

    // Run on view transition page load and initial load
    document.addEventListener('astro:page-load', initHeroAnimation);
    initHeroAnimation();
  </script>

</BaseLayout>
