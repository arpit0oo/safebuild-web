    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-16" data-aos="fade-up">
        <SectionLabel text="— INDUSTRIES" />
        <h2 class="font-headline-lg text-headline-lg text-on-surface uppercase mt-4">
