      </div>

      {/* Featured Products Grid */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch mb-12">
        {featuredProducts.map((p, i) => (
          <div class="flex flex-col" data-aos="fade-up" data-aos-delay={String(i * 80)}>
            <ProductCard
              name={p.name}
              category={p.category}
              shortDescription={p.shortDescription}
              imageUrl={p.imageUrl}
              slug={p.slug}
              capacity={p.specs?.capacity ?? ''}
