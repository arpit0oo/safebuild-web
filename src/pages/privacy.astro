---
// =============================================================
// src/pages/privacy.astro — Safe Build Engineering
// Privacy Policy page.
// =============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
---

<BaseLayout
  title="Privacy Policy — Safe Build Engineering"
  description="How Safe Build Engineering collects, uses and protects the information you share through this website."
>

  <!-- ============================================================
       SECTION 1: COMPACT HERO
       ============================================================ -->
  <section class="relative bg-[#0D1117] text-white border-b border-gray-800">
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-primary-container"></div>
    <div class="max-w-container-max mx-auto px-gutter py-16 md:py-20">
      <div class="max-w-3xl">
        <SectionLabel text="LEGAL" />
        <h1 class="font-headline-lg text-4xl sm:text-5xl text-surface-white tracking-tight uppercase mt-4 mb-3">
          Privacy Policy
        </h1>
        <p class="text-gray-300 text-sm font-technical-data">
          Last updated: 13 October 2026
        </p>
      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 2: CONTENT
       ============================================================ -->
  <section class="bg-surface-white py-section-padding">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="max-w-3xl">

        <h2 id="who-we-are" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Who we are
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          Safebuild Engineering Private Limited ("Safe Build Engineering", "we", "us") operates safebuilds.in. Address: 891, Murlipur Goyala, Near RSB Transmission Ltd., Behind Tata Telco, Deva Road, Lucknow — 226028, Uttar Pradesh, India. Email: <a href="mailto:info@safebuilds.in" class="text-primary-container hover:underline">info@safebuilds.in</a>. Phone: <a href="tel:+919935105322" class="text-primary-container hover:underline">+91 99351 05322</a>.
        </p>

        <h2 id="what-we-collect" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          What we collect
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          We collect only what you choose to submit through our enquiry and quote request forms: your name, company name, email address, phone number, your message, and project details such as product of interest, capacity, span and notes. We do not run user accounts and we do not take payments on this website.
        </p>

        <h2 id="how-we-use-your-information" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          How we use your information
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          We use it to respond to your enquiry, prepare quotations, and follow up on your request. We do not sell your personal information.
        </p>

        <h2 id="how-your-information-is-handled" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          How your information is handled
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          Form submissions are sent through Web3Forms and delivered to our business email, which is hosted on Zoho Mail. This website is hosted on Cloudflare, which may process technical data such as your IP address to deliver the site and keep it secure. Product and category content on this site is managed through Sanity.
        </p>

        <h2 id="third-party-services" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Third-party services on this website
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          To display this website, your browser may connect to the following third-party services, which receive technical information such as your IP address:
        </p>
        <ul class="list-disc pl-6 space-y-2 mb-4 font-body-md text-body-md text-on-surface-variant">
          <li>Google Fonts and Google Material Symbols (fonts and icons)</li>
          <li>Google Maps (embedded map on the Contact page)</li>
          <li>Cloudflare (hosting and delivery)</li>
          <li>Sanity (product images and content delivery)</li>
          <li>Unsplash (some images on the site)</li>
          <li>WhatsApp (only if you click a chat link, which opens WhatsApp)</li>
        </ul>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          These services operate under their own privacy policies.
        </p>

        <h2 id="cookies-and-analytics" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Cookies and analytics
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          We do not use analytics or advertising cookies on this website, and we do not show a cookie banner. Embedded third-party content, such as Google Maps, may set its own cookies according to the provider's policies.
        </p>

        <h2 id="how-long-we-keep-your-information" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          How long we keep your information
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          We keep enquiry and quotation details for as long as reasonably needed to respond to you, handle any resulting business relationship, and meet our record-keeping and legal obligations. You can ask us to delete your personal data at any time by emailing <a href="mailto:info@safebuilds.in" class="text-primary-container hover:underline">info@safebuilds.in</a>, and we will do so unless we are required to keep it.
        </p>

        <h2 id="your-rights" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Your rights
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          You can ask us to tell you what personal data we hold about you, correct it, or delete it, and you can raise a complaint about how we handle it. Email <a href="mailto:info@safebuilds.in" class="text-primary-container hover:underline">info@safebuilds.in</a> and we will respond within a reasonable time. We handle personal data in line with applicable Indian law, including the Digital Personal Data Protection Act, 2023.
        </p>

        <h2 id="security" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Security
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          We take reasonable measures to protect the information you send us. No method of transmission over the internet is completely secure, so we cannot guarantee absolute security.
        </p>

        <h2 id="children" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Children
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          This website is intended for business users and is not directed at children.
        </p>

        <h2 id="changes-to-this-policy" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Changes to this policy
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          We may update this policy from time to time. The 'Last updated' date at the top shows when it last changed.
        </p>

        <h2 id="contact" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Contact
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          For any privacy question or request, contact us at <a href="mailto:info@safebuilds.in" class="text-primary-container hover:underline">info@safebuilds.in</a> or <a href="tel:+919935105322" class="text-primary-container hover:underline">+91 99351 05322</a>.
        </p>

      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 3: SLIM CONTACT STRIP
       ============================================================ -->
  <section class="bg-image-placeholder py-12 border-t border-border-subtle">
    <div class="max-w-container-max mx-auto px-gutter text-center flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <p class="font-body-md text-body-md text-on-surface-variant font-medium">
        Questions about this policy?
      </p>
      <a href="mailto:info@safebuilds.in" class="text-primary-container hover:underline font-body-md text-body-md">
        info@safebuilds.in
      </a>
      <a href="/contact" class="btn-secondary">
        Contact Us
      </a>
    </div>
  </section>

</BaseLayout>
