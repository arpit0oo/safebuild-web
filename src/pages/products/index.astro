---
// =============================================================
// src/pages/products/index.astro — Safe Build Engineering
// Phase 4: Products Listing Page — v2 with category cards
//
// SSR: fetches all published products from Firestore.
// Category filtering: client-side JS via data-category attributes.
// No page reload on filter — instant show/hide.
// Navbar/Footer come from BaseLayout — NOT duplicated here.
// =============================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getProducts } from '../../lib/firestore';
import type { Product } from '../../lib/types';

// ── FIRESTORE FETCH (SSR) ─────────────────────────────────────
// All published products in one call — client-side filter handles
// category selection with zero additional Firestore reads.
let allProducts: Product[] = [];
let fetchError = false;

try {
  allProducts = await getProducts();
} catch (e) {
  console.error('[products/index] Firestore fetch failed:', e);
  fetchError = true;
}

// ── BUILD CATEGORY LIST FROM PRODUCTS ─────────────────────────
// Derive categories from the returned product set — no separate
// categories collection fetch needed. The image for each category
// card comes from the first product in that category.
interface CategoryCard {
  slug: string;
  label: string;
  count: number;
  image: string;
}

function slugToLabel(slug: string): string {
  return slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

const categoryMap = new Map<string, CategoryCard>();
for (const p of allProducts) {
  if (!categoryMap.has(p.category)) {
    categoryMap.set(p.category, {
      slug: p.category,
      label: p.categoryName ?? slugToLabel(p.category),
      count: 0,
      image: p.image ?? '',
    });
  }
  categoryMap.get(p.category)!.count++;
}

const categoryCards: CategoryCard[] = Array.from(categoryMap.values())
  .sort((a, b) => a.label.localeCompare(b.label));

// ── PAGE META ─────────────────────────────────────────────────
const pageTitle = 'Products — Industrial Cranes & Hoists | Safe Build Engineering';
const pageDesc  = "Explore Safe Build Engineering's full range of cranes, hoists, and lifting solutions — precision-engineered for Indian industry.";
---

<BaseLayout title={pageTitle} description={pageDesc} activePage="products">

  <!-- ============================================================
       SECTION 1 — PAGE HERO (unchanged)
       2-col: left = headline + lead | right = industrial image
       ============================================================ -->
  <section class="bg-surface-white border-b border-border-subtle w-full flex items-center min-h-[400px]">
    <div class="max-w-container-max mx-auto px-gutter w-full grid grid-cols-1 md:grid-cols-2 gap-stack-lg items-center py-section-padding md:py-0">

      <!-- Left: copy -->
      <div class="flex flex-col gap-stack-sm pr-0 md:pr-12">
        <SectionLabel text="OUR PRODUCTS" />
        <h1
          class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface uppercase mt-2"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Precision Cranes.<br />Built for India.
        </h1>
        <p
          class="font-body-lg text-body-lg text-on-surface-variant mt-4 max-w-lg"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Explore our full range of EOT cranes, gantry cranes, and hoists —
          engineered for reliability in the most demanding industrial environments.
        </p>
      </div>

      <!-- Right: hero image -->
      <div class="h-64 md:h-[400px] w-full bg-image-placeholder relative border-l border-border-subtle overflow-hidden">
        <img
          class="w-full h-full object-cover grayscale-[20%] contrast-125"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAj2FlvGzfYJvklhosomGBaTFYJahWsw-1_oiT-9QNgmlfXfOKiWhODzmccTH6bwKyk2NeTaZyV5K_RT4DIOOqiIq3a4UCJuo02Q9fQYb5R3O1qTUGS84pY-kHTXgOwCb0ks7p-mJnMqxp5Br-D504H4OmnOZVAsmtxY2sIBA3fXYU6FVupGXRJSJoqxjE002lCL8vDI-3CNCsGBCzGqW3gtZt4hNhqW_PmzOMTeps0mB9Bdl0JmiRU"
          alt="Wide-shot of an industrial manufacturing facility with overhead EOT cranes — Safe Build Engineering"
          loading="eager"
          fetchpriority="high"
        />
      </div>

    </div>
  </section>


  <!-- ============================================================
       SECTION 2 — CATEGORY CARDS GRID
       4-col desktop, 3-col tablet, 2-col mobile.
       Client-side filter on click — no page reload.
       "ALL" card first. Selected card: orange border.
       ============================================================ -->
  <section class="bg-image-placeholder border-b border-border-subtle w-full py-section-padding">
    <div class="max-w-container-max mx-auto px-gutter">

      <div class="mb-10" data-aos="fade-up">
        <SectionLabel text="— BROWSE BY CATEGORY" />
        <h2 class="font-headline-md text-headline-md text-on-surface uppercase mt-3">
          {categoryCards.length} Categories
        </h2>
      </div>

      <!-- Category cards grid -->
      <div
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"
        id="category-grid"
        role="listbox"
        aria-label="Filter products by category"
      >

        <!-- ALL card — always first -->
        <button
          class="category-card group text-left border-2 border-primary-container bg-surface-white relative overflow-hidden cursor-pointer transition-all duration-150"
          data-category="all"
          role="option"
          aria-selected="true"
          id="cat-btn-all"
        >
          <!-- Image area -->
          <div class="aspect-[4/3] bg-image-placeholder relative overflow-hidden flex items-center justify-center border-b border-border-subtle">
            <span class="material-symbols-outlined text-surface-variant text-[64px]">
              precision_manufacturing
            </span>
          </div>
          <!-- Card body -->
          <div class="p-4">
            <p class="font-label-caps text-label-caps text-on-surface uppercase tracking-widest leading-tight">
              All Products
            </p>
            <span class="inline-block mt-2 bg-primary-container text-surface-white font-technical-data text-technical-data px-2 py-0.5">
              {allProducts.length}
            </span>
          </div>
          <!-- Active indicator bar -->
          <div class="cat-indicator absolute bottom-0 left-0 right-0 h-[3px] bg-primary-container"></div>
        </button>

        <!-- One card per category -->
        {categoryCards.map((cat, i) => (
          <button
            class="category-card group text-left border-2 border-border-subtle bg-surface-white relative overflow-hidden cursor-pointer transition-all duration-150 hover:border-primary-container"
            data-category={cat.slug}
            role="option"
            aria-selected="false"
            id={`cat-btn-${cat.slug}`}
            data-aos="fade-up"
            data-aos-delay={String((i % 4) * 60)}
          >
            <!-- Category image -->
            <div class="aspect-[4/3] bg-image-placeholder relative overflow-hidden border-b border-border-subtle">
              {cat.image ? (
                <img
                  src={cat.image}
                  alt={cat.label}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="material-symbols-outlined text-surface-variant text-[48px]">
                    construction
                  </span>
                </div>
              )}
            </div>
            <!-- Card body -->
            <div class="p-4">
              <p class="font-label-caps text-label-caps text-on-surface uppercase tracking-widest leading-tight line-clamp-2">
                {cat.label}
              </p>
              <span class="inline-block mt-2 bg-image-placeholder text-on-surface-variant font-technical-data text-technical-data px-2 py-0.5 border border-border-subtle">
                {cat.count}
              </span>
            </div>
            <!-- Active indicator bar (hidden by default) -->
            <div class="cat-indicator absolute bottom-0 left-0 right-0 h-[3px] bg-primary-container opacity-0"></div>
          </button>
        ))}

      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 3 — PRODUCTS GRID
       Products pre-rendered server-side with data-category attrs.
       JS filters via show/hide — no re-render needed.
       ============================================================ -->
  <section class="bg-surface-white py-section-padding w-full" id="products-section">
    <div class="max-w-container-max mx-auto px-gutter">

      <!-- Active category label (updated by JS) -->
      <div class="mb-10 pb-6 border-b border-border-subtle flex items-center justify-between flex-wrap gap-4" id="section-header">
        <div>
          <SectionLabel text="— ALL PRODUCTS" id="active-label" />
          <h2 class="font-headline-md text-headline-md text-on-surface mt-1" id="active-count">
            {allProducts.length} Products Available
          </h2>
        </div>
        <button
          class="font-label-caps text-label-caps text-on-surface-variant hover:text-primary-container transition-colors flex items-center gap-1 uppercase tracking-wider hidden"
          id="clear-filter-btn"
          type="button"
        >
          <span class="material-symbols-outlined text-[16px] leading-none">close</span>
          Clear Filter
        </button>
      </div>

      {/* ── ERROR STATE ── */}
      {fetchError && (
        <div class="py-20 text-center">
          <span class="material-symbols-outlined text-[64px] text-surface-variant block mb-4">cloud_off</span>
          <h2 class="font-headline-sm text-headline-sm text-on-surface mb-2">Could Not Load Products</h2>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md mx-auto mb-6">
            We couldn't reach our product database. Please try again in a moment.
          </p>
          <a href="/products" class="btn-primary">Retry</a>
        </div>
      )}

      {/* ── EMPTY STATE ── */}
      {!fetchError && allProducts.length === 0 && (
        <div class="py-20 text-center">
          <span class="material-symbols-outlined text-[64px] text-surface-variant block mb-4">inventory_2</span>
          <h2 class="font-headline-sm text-headline-sm text-on-surface mb-2">No Products Listed Yet</h2>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md mx-auto mb-6">
            Our catalogue is being updated. Contact us directly for available models.
          </p>
          <a href="/contact?type=quote" class="btn-primary">Request a Quote</a>
        </div>
      )}

      {/* ── PRODUCT GRID ── */}
      {!fetchError && allProducts.length > 0 && (
        <>
          {/* No-results message (shown by JS when a category has 0 visible products) */}
          <div class="py-20 text-center hidden" id="no-results">
            <span class="material-symbols-outlined text-[64px] text-surface-variant block mb-4">search_off</span>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2" id="no-results-label">
              No Products in This Category
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-md mx-auto mb-6">
              Our catalogue is being updated. Contact us directly for available models.
            </p>
            <a href="/contact?type=quote" class="btn-primary">Request a Quote</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
            {allProducts.map((product, i) => (
              <div
                class="product-item flex flex-col"
                data-category={product.category}
                data-aos="fade-up"
                data-aos-delay={String((i % 3) * 80)}
              >
                <ProductCard
                  name={product.name}
                  category={product.category}
                  categoryName={product.categoryName}
                  shortDescription={product.shortDescription}
                  image={product.image}
                  slug={product.slug}
                />
              </div>
            ))}
          </div>
        </>
      )}

    </div>
  </section>


  <!-- ============================================================
       SECTION 4 — CTA BANNER (unchanged)
       ============================================================ -->
  <CTABanner
    heading="Need a Custom Lifting Solution?"
    subtext="Tell us your load requirements and our engineers will design the right crane for your facility."
    primaryLabel="Request a Quote"
    primaryHref="/contact?type=quote"
    secondaryLabel="Contact Us"
    secondaryHref="/contact"
  />

</BaseLayout>


<!-- ============================================================
     CLIENT-SIDE FILTER SCRIPT
     Reads data-category on .product-item divs.
     No framework — vanilla JS only.
     ============================================================ -->
<script is:inline>
(function () {
  const catButtons   = document.querySelectorAll('.category-card');
  const productItems = document.querySelectorAll('.product-item');
  const activeLabel  = document.getElementById('active-label');
  const activeCount  = document.getElementById('active-count');
  const clearBtn     = document.getElementById('clear-filter-btn');
  const noResults    = document.getElementById('no-results');
  const noResultsLbl = document.getElementById('no-results-label');
  const productGrid  = document.getElementById('product-grid');

  if (!catButtons.length || !productItems.length) return;

  function slugToLabel(slug) {
    return slug.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
  }

  function applyFilter(selectedCategory) {
    var visibleCount = 0;

    productItems.forEach(function (item) {
      var cat = item.getAttribute('data-category');
      var show = selectedCategory === 'all' || cat === selectedCategory;
      item.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    // Update section header
    if (selectedCategory === 'all') {
      if (activeLabel) activeLabel.textContent = '— ALL PRODUCTS';
      if (activeCount) activeCount.textContent = visibleCount + ' Products Available';
      if (clearBtn)    clearBtn.classList.add('hidden');
    } else {
      var label = slugToLabel(selectedCategory);
      if (activeLabel) activeLabel.textContent = '— ' + label.toUpperCase();
      if (activeCount) activeCount.textContent = visibleCount + ' ' + label + (visibleCount === 1 ? ' Product' : ' Products') + ' Available';
      if (clearBtn)    clearBtn.classList.remove('hidden');
    }

    // No-results message
    if (noResults && productGrid) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
        productGrid.classList.add('hidden');
        if (noResultsLbl) noResultsLbl.textContent = 'No ' + slugToLabel(selectedCategory) + ' Listed Yet';
      } else {
        noResults.classList.add('hidden');
        productGrid.classList.remove('hidden');
      }
    }
  }

  function setActiveCard(selectedCategory) {
    catButtons.forEach(function (btn) {
      var isActive = btn.getAttribute('data-category') === selectedCategory;
      var indicator = btn.querySelector('.cat-indicator');

      btn.setAttribute('aria-selected', isActive ? 'true' : 'false');

      if (isActive) {
        btn.classList.remove('border-border-subtle');
        btn.classList.add('border-primary-container');
        if (indicator) indicator.classList.remove('opacity-0');
        // Update count badge to orange on active card
        var badge = btn.querySelector('span.inline-block');
        if (badge) {
          badge.classList.remove('bg-image-placeholder', 'text-on-surface-variant', 'border', 'border-border-subtle');
          badge.classList.add('bg-primary-container', 'text-surface-white');
        }
      } else {
        btn.classList.add('border-border-subtle');
        btn.classList.remove('border-primary-container');
        if (indicator) indicator.classList.add('opacity-0');
        // Restore badge style — but not on the ALL card (it stays orange when inactive too)
        var badge = btn.querySelector('span.inline-block');
        if (badge && btn.getAttribute('data-category') !== 'all') {
          badge.classList.add('bg-image-placeholder', 'text-on-surface-variant', 'border', 'border-border-subtle');
          badge.classList.remove('bg-primary-container', 'text-surface-white');
        }
      }
    });
  }

  // Wire up click handlers
  catButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cat = btn.getAttribute('data-category');
      setActiveCard(cat);
      applyFilter(cat);

      // Smooth scroll to products section
      var productsSection = document.getElementById('products-section');
      if (productsSection) {
        productsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Clear filter button
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      setActiveCard('all');
      applyFilter('all');
    });
  }

  // Init: read ?category= URL param and pre-select matching card,
  // otherwise default to showing all products.
  (function () {
    var param = new URLSearchParams(window.location.search).get('category');
    if (param) {
      var matchBtn = document.querySelector('.category-card[data-category="' + param + '"]');
      if (matchBtn) {
        setActiveCard(param);
        applyFilter(param);
        return;
      }
    }
    applyFilter('all');
  })();
})();
</script>
