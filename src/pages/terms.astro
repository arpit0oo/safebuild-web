---
// =============================================================
// src/pages/terms.astro — Safe Build Engineering
// Terms of Service page.
// =============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
---

<BaseLayout
  title="Terms of Service — Safe Build Engineering"
  description="The terms that apply when you use the Safe Build Engineering website and submit enquiries or quote requests."
>

  <!-- ============================================================
       SECTION 1: COMPACT HERO
       ============================================================ -->
  <section class="relative bg-[#0D1117] text-white border-b border-gray-800">
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-primary-container"></div>
    <div class="max-w-container-max mx-auto px-gutter py-16 md:py-20">
      <div class="max-w-3xl">
        <SectionLabel text="LEGAL" />
        <h1 class="font-headline-lg text-4xl sm:text-5xl text-surface-white tracking-tight uppercase mt-4 mb-3">
          Terms of Service
        </h1>
        <p class="text-gray-300 text-sm font-technical-data">
          Last updated: 13 October 2026
        </p>
      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 2: CONTENT
       ============================================================ -->
  <section class="bg-surface-white py-section-padding">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="max-w-3xl">

        <h2 id="acceptance-of-terms" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Acceptance of terms
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          By accessing or using safebuilds.in you agree to these terms. If you do not agree, please do not use the website. The website is operated by Safebuild Engineering Private Limited ("Safe Build Engineering", "we", "us").
        </p>

        <h2 id="about-this-website" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          About this website
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          This website provides information about our cranes, hoists, and related services. Submitting an enquiry or quote request through the website is a request for information. It is not an order and does not create a contract between you and us.
        </p>

        <h2 id="product-information" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Product information
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          Descriptions, images, and specifications on this website are for general guidance and may change without notice. Images are illustrative. Final specifications, pricing, delivery timelines, and commercial terms are confirmed only in a written quotation from us.
        </p>

        <h2 id="quotations" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Quotations
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          A quotation is valid for the period stated in that quotation. Payment, delivery, and warranty terms are set out in the quotation or in a separate written agreement.
        </p>

        <h2 id="acceptable-use" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Acceptable use
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          When using this website you agree not to: use it for any unlawful purpose; attempt to disrupt, probe, or gain unauthorised access to the website or its systems; use automated tools to scrape its content; or submit false, misleading, or spam enquiries through our forms.
        </p>

        <h2 id="intellectual-property" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Intellectual property
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          All text, logos, images, and other content on this website belong to Safebuild Engineering Private Limited or its licensors. You may not copy, reproduce, or distribute them without our written permission.
        </p>

        <h2 id="safe-use-of-lifting-equipment" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Safe use of lifting equipment
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          Cranes and hoists must be installed, operated, and maintained by trained and authorised personnel in accordance with the manufacturer's instructions and applicable regulations. Information on this website does not replace professional engineering advice for your specific site and application.
        </p>

        <h2 id="disclaimer-and-limitation-of-liability" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Disclaimer and limitation of liability
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          This website is provided "as is" and "as available". To the extent permitted by law, we are not liable for any loss or damage arising from your use of this website or from relying on its content. Nothing in these terms limits liability that cannot be limited by law.
        </p>

        <h2 id="third-party-links-and-services" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Third-party links and services
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          This website may link to or embed third-party services such as Google Maps and WhatsApp. We are not responsible for their content or practices. Please also read our <a href="/privacy" class="text-primary-container hover:underline">Privacy Policy</a> for how information is handled.
        </p>

        <h2 id="governing-law-and-jurisdiction" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Governing law and jurisdiction
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          These terms are governed by the laws of India. Any dispute arising from them is subject to the exclusive jurisdiction of the courts at Lucknow, Uttar Pradesh.
        </p>

        <h2 id="changes-to-these-terms" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Changes to these terms
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          We may update these terms from time to time. The "Last updated" date at the top shows when they last changed. Continued use of the website means you accept the updated terms.
        </p>

        <h2 id="contact" class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight mt-10 mb-3 first:mt-0">
          Contact
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-4">
          For any question about these terms, contact us at <a href="mailto:info@safebuilds.in" class="text-primary-container hover:underline">info@safebuilds.in</a> or <a href="tel:+919935105322" class="text-primary-container hover:underline">+91 99351 05322</a>.
        </p>

      </div>
    </div>
  </section>


  <!-- ============================================================
       SECTION 3: SLIM CONTACT STRIP
       ============================================================ -->
  <section class="bg-image-placeholder py-12 border-t border-border-subtle">
    <div class="max-w-container-max mx-auto px-gutter text-center flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <p class="font-body-md text-body-md text-on-surface-variant font-medium">
        Questions about these terms?
      </p>
      <a href="mailto:info@safebuilds.in" class="text-primary-container hover:underline font-body-md text-body-md">
        info@safebuilds.in
      </a>
      <a href="/contact" class="btn-secondary">
        Contact Us
      </a>
    </div>
  </section>

</BaseLayout>
