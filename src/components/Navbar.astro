---
// =============================================================
// Navbar.astro — Safe Build Engineering
// Global sticky navigation. Used in BaseLayout.astro on every page.
// Props:
//   activePage — string slug to highlight the active nav link
//     values: 'home' | 'products' | 'about' | 'contact' | ''
//
// Desktop: Products has hover dropdown with category sub-links
// Mobile:  Products expands inline accordion showing all sub-links
// =============================================================

interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;

const productLinks = [
  { label: 'EOT Cranes',    href: '/products?category=eot-cranes'    },
  { label: 'Gantry Cranes', href: '/products?category=gantry-cranes' },
  { label: 'Hoists',        href: '/products?category=hoists'         },
];

const topLinks = [
  { label: 'About',   href: '/about',   key: 'about'   },
  { label: 'Contact', href: '/contact', key: 'contact' },
];
---

<!-- ============================================================
     NAVBAR HEADER
     ============================================================ -->
<header
  id="site-navbar"
  class="bg-surface-white border-b border-border-subtle sticky top-0 z-50 w-full"
>
  <div class="flex justify-between items-center w-full px-gutter max-w-container-max mx-auto h-20">

    <!-- ── LOGO ─────────────────────────────────────────────── -->
    <a href="/" class="flex items-center gap-2 no-underline" aria-label="Safe Build Engineering — Home">
      <span
        aria-hidden="true"
        class="material-symbols-outlined text-primary-container text-[26px] leading-none"
      >precision_manufacturing</span>
      <span class="font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight whitespace-nowrap">
        Safe Build Engineering
      </span>
    </a>

    <!-- ── DESKTOP NAV ────────────────────────────────────────── -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Primary navigation">

      <!-- Products dropdown trigger -->
      <div class="relative group" id="products-dropdown-wrapper">
        <button
          id="products-trigger"
          class="flex items-center gap-1 font-label-caps text-label-caps font-semibold text-on-surface hover:text-primary-container transition-colors duration-200 uppercase tracking-wider cursor-pointer focus:outline-none"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="products-dropdown"
        >
          Products
          <span class="material-symbols-outlined text-[16px] leading-none transition-transform duration-200 group-hover:rotate-180">
            keyboard_arrow_down
          </span>
        </button>

        <!-- Dropdown panel -->
        <div
          id="products-dropdown"
          class="absolute top-full left-0 mt-2 w-56 bg-surface-white border border-border-subtle shadow-[0_4px_24px_rgba(0,0,0,0.10)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
          role="menu"
        >
          <!-- Category links -->
          {productLinks.map(link => (
            <a
              href={link.href}
              class="block px-4 py-3 font-label-caps text-label-caps text-on-surface hover:text-primary-container border-l-[3px] border-transparent hover:border-primary-container hover:pl-5 transition-all duration-150 uppercase tracking-wider"
              role="menuitem"
            >
              {link.label}
            </a>
          ))}

          <!-- Divider -->
          <div class="border-t border-border-subtle mx-3 my-1"></div>

          <!-- View all -->
          <a
            href="/products"
            class="flex items-center gap-1.5 px-4 py-3 font-label-caps text-label-caps text-primary-container hover:text-on-surface font-semibold border-l-[3px] border-transparent hover:border-primary-container hover:pl-5 transition-all duration-150 uppercase tracking-wider"
            role="menuitem"
          >
            View All Products
            <span class="material-symbols-outlined text-[14px] leading-none">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- About + Contact -->
      {topLinks.map(link => (
        <a
          href={link.href}
          class={
            activePage === link.key
              ? 'font-label-caps text-label-caps font-semibold text-primary-container border-b-2 border-primary-container pb-0.5 transition-colors duration-200 uppercase tracking-wider'
              : 'font-label-caps text-label-caps font-semibold text-on-surface hover:text-primary-container transition-colors duration-200 uppercase tracking-wider'
          }
          aria-current={activePage === link.key ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- ── DESKTOP CTA ─────────────────────────────────────── -->
    <a
      href="/contact?type=quote"
      class="!hidden md:!inline-flex items-center gap-1.5 btn-primary text-[12px] py-2.5 px-5"
      id="desktop-quote-cta"
    >
      REQUEST QUOTE
      <span class="material-symbols-outlined text-[15px] leading-none">arrow_forward</span>
    </a>

    <!-- ── MOBILE HAMBURGER ──────────────────────────────────── -->
    <button
      id="nav-hamburger"
      class="md:hidden text-on-surface p-1 focus:outline-none"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="material-symbols-outlined text-[28px] leading-none" id="hamburger-icon">menu</span>
    </button>

  </div>
</header>


<!-- ============================================================
     MOBILE DRAWER OVERLAY
     ============================================================ -->

<!-- Backdrop -->
<div
  id="nav-backdrop"
  class="fixed inset-0 bg-on-background/50 z-40 hidden opacity-0 transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<!-- Drawer panel -->
<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 h-full w-72 bg-surface-white z-50 translate-x-full transition-transform duration-300 ease-in-out flex flex-col md:hidden shadow-2xl"
  aria-label="Mobile navigation"
  role="dialog"
  aria-modal="true"
>
  <!-- Drawer header -->
  <div class="flex items-center justify-between px-gutter h-20 border-b border-border-subtle shrink-0">
    <span class="font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight text-sm">
      Safe Build
    </span>
    <button
      id="nav-close"
      class="text-on-surface p-1 focus:outline-none"
      aria-label="Close navigation menu"
    >
      <span class="material-symbols-outlined text-[28px] leading-none">close</span>
    </button>
  </div>

  <!-- Drawer nav links -->
  <nav class="flex flex-col px-gutter py-4 gap-0 grow overflow-y-auto" aria-label="Mobile navigation links">

    <!-- Products accordion -->
    <div>
      <button
        id="mobile-products-toggle"
        class="w-full flex items-center justify-between font-label-caps text-label-caps font-semibold uppercase tracking-wider py-3.5 border-b border-border-subtle text-on-surface text-left transition-colors duration-150"
        aria-expanded="false"
        aria-controls="mobile-products-submenu"
      >
        Products
        <span class="material-symbols-outlined text-[18px] leading-none transition-transform duration-200" id="mobile-products-icon">
          keyboard_arrow_down
        </span>
      </button>

      <!-- Submenu — hidden by default -->
      <div id="mobile-products-submenu" class="hidden flex-col bg-image-placeholder border-b border-border-subtle">
        {productLinks.map(link => (
          <a
            href={link.href}
            class="block px-4 py-3 font-label-caps text-label-caps text-on-surface-variant hover:text-primary-container border-l-[3px] border-transparent hover:border-primary-container hover:pl-6 transition-all duration-150 uppercase tracking-wider text-[12px]"
          >
            {link.label}
          </a>
        ))}
        <div class="border-t border-border-subtle mx-3 my-1"></div>
        <a
          href="/products"
          class="flex items-center gap-1.5 px-4 py-3 font-label-caps text-label-caps text-primary-container font-semibold border-l-[3px] border-transparent hover:border-primary-container hover:pl-6 transition-all duration-150 uppercase tracking-wider text-[12px]"
        >
          View All Products
          <span class="material-symbols-outlined text-[13px] leading-none">arrow_forward</span>
        </a>
      </div>
    </div>

    <!-- About + Contact -->
    {topLinks.map(link => (
      <a
        href={link.href}
        class={[
          'font-label-caps text-label-caps font-semibold uppercase tracking-wider py-3.5 border-b border-border-subtle transition-all duration-150',
          activePage === link.key
            ? 'text-primary-container border-l-[3px] border-l-primary-container pl-3'
            : 'text-on-surface hover:text-primary-container hover:pl-2',
        ].join(' ')}
        aria-current={activePage === link.key ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Drawer CTA -->
  <div class="px-gutter pb-8 pt-4 shrink-0">
    <a href="/contact?type=quote" class="btn-primary w-full justify-center">
      Request Quote
      <span class="material-symbols-outlined text-[16px] leading-none">arrow_forward</span>
    </a>
  </div>
</aside>


<!-- ============================================================
     SCRIPTS
     Desktop: hover handled by Tailwind group-hover
     Mobile:  hamburger + Products accordion JS
     ============================================================ -->
<script>
  // ── Desktop: keyboard accessibility for dropdown ──────────────
  const trigger = document.getElementById('products-trigger') as HTMLButtonElement | null;
  const dropdown = document.getElementById('products-dropdown') as HTMLElement | null;

  trigger?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
    }
  });

  // ── Mobile drawer ─────────────────────────────────────────────
  const hamburger     = document.getElementById('nav-hamburger')!;
  const closeBtn      = document.getElementById('nav-close')!;
  const drawer        = document.getElementById('mobile-drawer')!;
  const backdrop      = document.getElementById('nav-backdrop')!;
  const hamburgerIcon = document.getElementById('hamburger-icon')!;

  let isOpen = false;

  function openDrawer() {
    isOpen = true;
    drawer.classList.remove('translate-x-full');
    backdrop.classList.remove('hidden', 'opacity-0');
    requestAnimationFrame(() => backdrop.classList.add('opacity-100'));
    hamburger.setAttribute('aria-expanded', 'true');
    hamburgerIcon.textContent = 'close';
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    isOpen = false;
    drawer.classList.add('translate-x-full');
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    setTimeout(() => backdrop.classList.add('hidden'), 300);
    hamburger.setAttribute('aria-expanded', 'false');
    hamburgerIcon.textContent = 'menu';
    document.body.style.overflow = '';
  }

  hamburger.addEventListener('click', () => isOpen ? closeDrawer() : openDrawer());
  closeBtn.addEventListener('click', closeDrawer);
  backdrop.addEventListener('click', closeDrawer);
  drawer.querySelectorAll('a').forEach(link => link.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) closeDrawer(); });

  // ── Mobile Products accordion ─────────────────────────────────
  const mobileProductsToggle  = document.getElementById('mobile-products-toggle') as HTMLButtonElement | null;
  const mobileProductsSubmenu = document.getElementById('mobile-products-submenu') as HTMLElement | null;
  const mobileProductsIcon    = document.getElementById('mobile-products-icon') as HTMLElement | null;

  mobileProductsToggle?.addEventListener('click', () => {
    const isExpanded = mobileProductsToggle.getAttribute('aria-expanded') === 'true';

    if (isExpanded) {
      mobileProductsSubmenu?.classList.remove('flex');
      mobileProductsSubmenu?.classList.add('hidden');
      mobileProductsIcon?.classList.remove('rotate-180');
      mobileProductsToggle.setAttribute('aria-expanded', 'false');
    } else {
      mobileProductsSubmenu?.classList.remove('hidden');
      mobileProductsSubmenu?.classList.add('flex');
      mobileProductsIcon?.classList.add('rotate-180');
      mobileProductsToggle.setAttribute('aria-expanded', 'true');
    }
  });
</script>
