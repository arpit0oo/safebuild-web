---
// =============================================================
// Navbar.astro — Safe Build Engineering
// Global sticky navigation. Used in BaseLayout.astro on every page.
// Props:
//   activePage — string slug to highlight the active nav link
//     values: 'home' | 'products' | 'about' | 'contact' | ''
//
// Desktop + Mobile: Products is a plain link to /products
// =============================================================

interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;



const topLinks = [
  { label: 'About',   href: '/about',   key: 'about'   },
  { label: 'Contact', href: '/contact', key: 'contact' },
];
---

<!-- ============================================================
     NAVBAR HEADER
     ============================================================ -->
<header
  id="site-navbar"
  class="bg-surface-white border-b border-border-subtle sticky top-0 z-50 w-full"
  style="pointer-events: auto !important;"
>
  <div class="flex justify-between items-center w-full px-gutter max-w-container-max mx-auto h-20">

    <!-- ── LOGO ─────────────────────────────────────────────── -->
    <a href="/" class="flex items-center gap-2 no-underline" aria-label="Safe Build Engineering — Home">
      <span
        aria-hidden="true"
        class="material-symbols-outlined text-primary-container text-[26px] leading-none"
      >precision_manufacturing</span>
      <span class="font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight whitespace-nowrap">
        Safe Build Engineering
      </span>
    </a>

    <!-- ── DESKTOP NAV ────────────────────────────────────────── -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Primary navigation">

      <!-- Products link -->
      <a
        href="/products"
        class={
          activePage === 'products'
            ? 'font-label-caps text-label-caps font-semibold text-primary-container border-b-2 border-primary-container pb-0.5 transition-colors duration-200 uppercase tracking-wider'
            : 'font-label-caps text-label-caps font-semibold text-on-surface hover:text-primary-container transition-colors duration-200 uppercase tracking-wider'
        }
        aria-current={activePage === 'products' ? 'page' : undefined}
      >
        Products
      </a>

      <!-- About + Contact -->
      {topLinks.map(link => (
        <a
          href={link.href}
          class={
            activePage === link.key
              ? 'font-label-caps text-label-caps font-semibold text-primary-container border-b-2 border-primary-container pb-0.5 transition-colors duration-200 uppercase tracking-wider'
              : 'font-label-caps text-label-caps font-semibold text-on-surface hover:text-primary-container transition-colors duration-200 uppercase tracking-wider'
          }
          aria-current={activePage === link.key ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- ── DESKTOP CTA ─────────────────────────────────────── -->
    <a
      href="/contact?type=quote"
      class="!hidden md:!inline-flex items-center gap-1.5 btn-primary text-[12px] py-2.5 px-5"
      id="desktop-quote-cta"
    >
      REQUEST QUOTE
      <span class="material-symbols-outlined text-[15px] leading-none">arrow_forward</span>
    </a>

    <!-- ── MOBILE HAMBURGER ──────────────────────────────────── -->
    <button
      id="nav-hamburger"
      class="md:hidden text-on-surface p-1 focus:outline-none relative z-[60]"
      style="pointer-events: auto !important; touch-action: manipulation;"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="material-symbols-outlined text-[28px] leading-none" id="hamburger-icon">menu</span>
    </button>

  </div>
</header>


<!-- ============================================================
     MOBILE DRAWER OVERLAY
     ============================================================ -->

<!-- Backdrop -->
<div
  id="nav-backdrop"
  class="fixed inset-0 bg-on-background/50 z-40 hidden opacity-0 transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<!-- Drawer panel -->
<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 h-full w-72 bg-surface-white z-50 translate-x-full transition-transform duration-300 ease-in-out flex flex-col md:hidden shadow-2xl"
  aria-label="Mobile navigation"
  role="dialog"
  aria-modal="true"
>
  <!-- Drawer header -->
  <div class="flex items-center justify-between px-gutter h-20 border-b border-border-subtle shrink-0">
    <span class="font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight text-sm">
      Safe Build
    </span>
    <button
      id="nav-close"
      class="text-on-surface p-1 focus:outline-none"
      aria-label="Close navigation menu"
    >
      <span class="material-symbols-outlined text-[28px] leading-none">close</span>
    </button>
  </div>

  <!-- Drawer nav links -->
  <nav class="flex flex-col px-gutter py-4 gap-0 grow overflow-y-auto" aria-label="Mobile navigation links">

    <!-- Products link -->
    <a
      href="/products"
      class={[
        'font-label-caps text-label-caps font-semibold uppercase tracking-wider py-3.5 border-b border-border-subtle transition-all duration-150',
        activePage === 'products'
          ? 'text-primary-container border-l-[3px] border-l-primary-container pl-3'
          : 'text-on-surface hover:text-primary-container hover:pl-2',
      ].join(' ')}
      aria-current={activePage === 'products' ? 'page' : undefined}
    >
      Products
    </a>

    <!-- About + Contact -->
    {topLinks.map(link => (
      <a
        href={link.href}
        class={[
          'font-label-caps text-label-caps font-semibold uppercase tracking-wider py-3.5 border-b border-border-subtle transition-all duration-150',
          activePage === link.key
            ? 'text-primary-container border-l-[3px] border-l-primary-container pl-3'
            : 'text-on-surface hover:text-primary-container hover:pl-2',
        ].join(' ')}
        aria-current={activePage === link.key ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Drawer CTA -->
  <div class="px-gutter pb-8 pt-4 shrink-0">
    <a href="/contact?type=quote" class="btn-primary w-full justify-center">
      Request Quote
      <span class="material-symbols-outlined text-[16px] leading-none">arrow_forward</span>
    </a>
  </div>
</aside>


<!-- ============================================================
     SCRIPTS
     Mobile: hamburger open/close drawer
     ============================================================ -->
<script>


  // ── Mobile drawer ─────────────────────────────────────────────
  // Re-initialised after every View Transition swap, because <body> is
  // replaced and the new nodes would otherwise have no listeners.
  let closeCurrentDrawer: (() => void) | null = null;
  let drawerIsOpen = false;

  function initNavbar() {
    const hamburger     = document.getElementById('nav-hamburger');
    const closeBtn      = document.getElementById('nav-close');
    const drawer        = document.getElementById('mobile-drawer');
    const backdrop      = document.getElementById('nav-backdrop');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    if (!hamburger || !closeBtn || !drawer || !backdrop || !hamburgerIcon) return;

    drawerIsOpen = false;

    function openDrawer() {
      drawerIsOpen = true;
      drawer!.classList.remove('translate-x-full');
      backdrop!.classList.remove('hidden', 'opacity-0');
      requestAnimationFrame(() => backdrop!.classList.add('opacity-100'));
      hamburger!.setAttribute('aria-expanded', 'true');
      hamburgerIcon!.textContent = 'close';
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawerIsOpen = false;
      drawer!.classList.add('translate-x-full');
      backdrop!.classList.remove('opacity-100');
      backdrop!.classList.add('opacity-0');
      setTimeout(() => backdrop!.classList.add('hidden'), 300);
      hamburger!.setAttribute('aria-expanded', 'false');
      hamburgerIcon!.textContent = 'menu';
      document.body.style.overflow = '';
    }

    closeCurrentDrawer = closeDrawer;

    hamburger.addEventListener('click', () => drawerIsOpen ? closeDrawer() : openDrawer());
    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);
    drawer.querySelectorAll('a').forEach(link => link.addEventListener('click', closeDrawer));
  }

  initNavbar();
  document.addEventListener('astro:after-swap', initNavbar);

  // Bound once on document — must not be re-added inside initNavbar
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawerIsOpen) closeCurrentDrawer?.();
  });


</script>
